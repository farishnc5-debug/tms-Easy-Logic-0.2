# Copy to .env (local) or set in your host's Environment Variables (production).
# Never commit the real values.

# Database. Local dev: file:./dev.db (SQLite). Production: your Postgres URL (e.g. Neon).
# Switch the schema with: node scripts/switch-db.js postgresql
DATABASE_URL="file:./dev.db"

# Signs/derives session security. Use a long random string in production.
SESSION_SECRET=""

# Encrypts Gmail/WhatsApp/Telegram credentials stored in the database.
# Generate once (e.g. `openssl rand -base64 32`) and NEVER change it afterwards,
# or already-saved integration credentials become unreadable.
APP_ENCRYPTION_KEY=""

# Required for the scheduled job (/api/cron/maintenance). Without it the job is
# disabled. On Vercel, set this and Cron sends it automatically.
CRON_SECRET=""

# Vercel Blob file storage (production). Leave empty locally to use disk.
BLOB_READ_WRITE_TOKEN=""

# Tracking Maps GPS (optional)
GPS_SERVER_URL="https://tracmap3.com"
GPS_USERNAME=""
GPS_PASSWORD=""
